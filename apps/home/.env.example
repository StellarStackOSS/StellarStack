# URL of the marketing API (apps/home → marketing service /waitlist).
VITE_MARKETING_URL=https://marketing.stellarstack.app

# Public Cloudflare Turnstile site key. Generate at
# https://dash.cloudflare.com → Turnstile → Add site.
# The matching secret key lives in the marketing service, never here.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAA_replace_me
