{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "StellarStack",
  "description": "Modern, open-source game-server control panel — multi-node, blueprint-driven, browser-direct daemon socket.",
  "colors": {
    "primary": "#A397E8",
    "light": "#C4BAF1",
    "dark": "#7C6FD9"
  },
  "background": {
    "color": {
      "dark": "#120F0C",
      "light": "#FFFFFF"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "concepts/architecture"
            ]
          },
          {
            "group": "Self-hosting",
            "pages": [
              "self-hosting/requirements",
              "self-hosting/install",
              "self-hosting/pair-node",
              "self-hosting/configuration",
              "self-hosting/updating"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/servers",
              "concepts/nodes",
              "concepts/blueprints",
              "concepts/allocations",
              "concepts/lifecycle"
            ]
          },
          {
            "group": "Operations",
            "pages": [
              "operations/console",
              "operations/files",
              "operations/sftp",
              "operations/backups",
              "operations/schedules",
              "operations/crash-reports"
            ]
          },
          {
            "group": "Multi-tenant",
            "pages": [
              "multi-tenant/users",
              "multi-tenant/subusers",
              "multi-tenant/permissions"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/two-factor",
              "security/passkeys",
              "security/api-tokens"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "api-reference/resources/servers",
              "api-reference/resources/backups",
              "api-reference/resources/schedules",
              "api-reference/resources/nodes"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/StellarStackOSS",
          "icon": "github"
        },
        {
          "anchor": "Roadmap",
          "href": "https://stellarstack.dev/#/roadmap",
          "icon": "map"
        },
        {
          "anchor": "Changelog",
          "href": "https://stellarstack.dev/#/changelog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://status.stellarstack.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open panel",
      "href": "https://stellarstack.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/StellarStackOSS"
    }
  }
}
