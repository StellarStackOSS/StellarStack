# Tiny init-container image: alpine + psql + openssl + the bootstrap
# script. Used by the Dockge / Portainer template to auto-pair the
# daemon with the API on first deploy. Image is < 30 MB; lives at
# ghcr.io/stellarstackoss/bootstrap:latest.

FROM alpine:3.20

RUN apk add --no-cache postgresql16-client openssl

COPY bootstrap.sh /usr/local/bin/bootstrap.sh
RUN chmod +x /usr/local/bin/bootstrap.sh

ENTRYPOINT ["/usr/local/bin/bootstrap.sh"]
